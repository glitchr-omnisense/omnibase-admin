{#- A PHP enum's case reads as in the form's select, not as its stored value -
    unless the field formats it itself (formatValue()), whose label wins. -#}
{%- set value = field.formattedValue -%}
{%- if field.value is not null and value is same as(admin_display(field.value)) -%}
    {%- set value = admin_enum_label(field.value) ?? value -%}
{%- endif -%}
{%- if value is null -%}
    <span style="color: var(--admin-muted)">—</span>
{%- elseif value is same as(true) or value is same as(false) -%}
    {{ value ? '✓' : '✕' }}
{%- elseif value is iterable -%}
    {{ value|length }} item{{ value|length != 1 ? 's' }}
{%- elseif field.customOption('renderAsHtml') -%}
    {{ value|raw }}
{%- else -%}
    {%- set value = '' ~ value -%}
    {%- set max = field.customOption('maxLength') ?? 64 -%}
    {{ value|length > max ? value|slice(0, max) ~ '…' : value }}
{%- endif -%}
