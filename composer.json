{
    "name": "omnibase/admin",
    "type": "symfony-bundle",
    "description": "Administration backoffice for base-bundle: dynamic CRUD, dashboard, menus and field-based form generation",
    "keywords": [
        "symfony",
        "admin",
        "backoffice",
        "crud",
        "dashboard"
    ],
    "homepage": "https://github.com/glitchr-omnisense/omnibase-admin",
    "license": "MIT",
    "authors": [
        {
            "name": "Marco Meyer",
            "email": "marco.meyer@glitchr.io"
        }
    ],
    "autoload": {
        "psr-4": {
            "Base\\Admin\\": "./src",
            "Base\\Admin\\Test\\": "./testing"
        },
        "files": [
            "src/Resources/former-names.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\Base\\Admin\\": "./tests"
        }
    },
    "require": {
        "php": "^8.1",
        "symfony/config": "^6.0|^7.0|^8.0",
        "symfony/dependency-injection": "^6.0|^7.0|^8.0",
        "symfony/http-kernel": "^6.0|^7.0|^8.0",
        "symfony/form": "^6.0|^7.0|^8.0",
        "omnibridge/symfony": "^1.1",
        "omnisense/omnibase": "^5.1"
    },
    "suggest": {
        "omnibridge/doctrine": "The persistence on Doctrine's ORM; also what a list still built on Doctrine's QueryBuilder (createIndexQueryBuilder(), Filter::applyWith()) and the former write hooks (persistEntity()...) need, both deprecated",
        "omnibridge/eloquent": "The persistence on Illuminate's database (base.persistence: eloquent): the back office reads and writes through it"
    },
    "require-dev": {
        "doctrine/orm": "^2.15|^3.0",
        "phpunit/phpunit": "^9.6",
        "symfony/framework-bundle": "^6.0|^7.0|^8.0",
        "symfony/twig-bundle": "^6.0|^7.0|^8.0",
        "symfony/var-dumper": "^6.0|^7.0|^8.0"
    },
    "config": {
        "allow-plugins": {
            "omnibridge/composer": true,
            "php-http/discovery": true
        },
        "preferred-install": {
            "*": "dist"
        },
        "sort-packages": true
    },
    "extra": {
        "branch-alias": {
            "dev-main": "1.x-dev"
        }
    }
}
